# API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://thesiflow:change-me-before-production@localhost:5433/thesiflow?schema=public
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000

# PostgreSQL Docker
POSTGRES_USER=thesiflow
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=thesiflow
POSTGRES_PORT=5433


ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
ADMIN_EMAIL=admin@thesiflow.local
ADMIN_PASSWORD=change-me-admin-password
APP_VERSION=0.1.0
OUTBOX_CLAIM_LIMIT=10
WORKER_POLL_INTERVAL_MS=5000


