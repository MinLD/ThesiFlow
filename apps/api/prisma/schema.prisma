generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  tenant
  faculty
  department
  project
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  TOKEN_REFRESHED
  REFRESH_TOKEN_REUSED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  RESET_PASSWORD_SUCCESS
  ACCOUNT_CREATED
  ROLE_ASSIGNED
}

enum OrganizationStatus {
  active
  disabled
  deleted
}

enum MembershipStatus {
  invited
  active
  inactive
}

enum MembershipSource {
  invitation
  import
  provisioning
}

enum MembershipInvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum IdempotencyRecordStatus {
  processing
  completed
  failed
}

enum OutboxEventStatus {
  pending
  processing
  published
  failed
}

enum SystemInfoStatus {
  active
  disabled
}

enum AccountStatus {
  pending_verification
  active
  disabled
}

enum AccountTokenPurpose {
  email_verification
  password_reset
}

enum AccountTokenStatus {
  active
  consumed
  revoked
  expired
}

enum SessionStatus {
  active
  revoked
  expired
}

model Account {
  id              String        @id @default(uuid())
  email           String        @unique
  fullName        String        @map("full_name")
  status          AccountStatus @default(pending_verification)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  credentials     AccountCredential[]
  tokens          AccountToken[]
  sessions        Session[]
  memberships     TenantMembership[]
  sentInvitations MembershipInvitation[] @relation("MembershipInvitationInviter")

  @@index([status])
  @@map("accounts")
}

model AccountCredential {
  id                String                @id @default(uuid())
  accountId         String                @map("account_id")
  passwordHash      String                @map("password_hash")
  passwordUpdatedAt DateTime?             @map("password_updated_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  account           Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId])
  @@map("account_credentials")
}

model AccountToken {
  id         String              @id @default(uuid())
  accountId  String              @map("account_id")
  tokenHash  String              @unique @map("token_hash")
  purpose    AccountTokenPurpose
  status     AccountTokenStatus  @default(active)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  revokedAt  DateTime?           @map("revoked_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, status])
  @@index([status])
  @@index([expiresAt])
  @@map("account_tokens")
}

model Session {
  id                   String        @id @default(uuid())
  accountId            String        @map("account_id")
  familyId             String        @map("family_id")
  refreshTokenHash     String        @unique @map("refresh_token_hash")
  status               SessionStatus @default(active)
  expiresAt            DateTime      @map("expires_at")
  revokedAt            DateTime?     @map("revoked_at")
  rotatedFromSessionId String?       @map("rotated_from_session_id")
  reusedAt             DateTime?     @map("reused_at")
  userAgent            String?       @map("user_agent")
  ipAddress            String?       @map("ip_address")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rotatedFrom Session?  @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id])
  rotatedTo   Session[] @relation("SessionRotation")

  @@index([accountId, status])
  @@index([familyId, status])
  @@index([refreshTokenHash, status])
  @@index([expiresAt])
  @@map("sessions")
}

model SystemInfo {
  id        String           @id @default(uuid())
  key       String           @unique
  value     String
  status    SystemInfoStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@map("system_info")
}

model SystemConfiguration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  version     Int      @default(1)
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("system_configurations")
}

model IdempotencyRecord {
  id             String                  @id @default(uuid())
  scope          String
  key            String
  requestHash    String                  @map("request_hash")
  status         IdempotencyRecordStatus @default(processing)
  responseStatus Int?                    @map("response_status")
  responseBody   Json?                   @map("response_body")
  lockedUntil    DateTime?               @map("locked_until")
  expiresAt      DateTime                @map("expires_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([status, expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     String            @map("event_type")
  aggregateType String?           @map("aggregate_type")
  aggregateId   String?           @map("aggregate_id")
  payload       Json
  status        OutboxEventStatus @default(pending)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at")
  lockedAt      DateTime?         @map("locked_at")
  publishedAt   DateTime?         @map("published_at")
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Organization {
  id         String             @id @default(uuid())
  name       String             @unique
  slug       String             @unique
  status     OrganizationStatus @default(active)
  verifiedAt DateTime?          @map("verified_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  deletedAt  DateTime?          @map("deleted_at")

  memberships TenantMembership[]
  invitations MembershipInvitation[]
  roles       Role[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

model TenantMembership {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  accountId      String           @map("account_id")
  status         MembershipStatus @default(invited)
  source         MembershipSource
  activatedAt    DateTime?        @map("activated_at")
  deactivatedAt  DateTime?        @map("deactivated_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, accountId])
  @@index([accountId, status])
  @@index([organizationId, status])
  @@map("tenant_memberships")
}

model MembershipInvitation {
  id                 String                     @id @default(uuid())
  organizationId     String                     @map("organization_id")
  email              String
  tokenHash          String                     @unique @map("token_hash")
  status             MembershipInvitationStatus @default(pending)
  invitedByAccountId String                     @map("invited_by_account_id")
  expiresAt          DateTime                   @map("expires_at")
  acceptedAt         DateTime?                  @map("accepted_at")
  revokedAt          DateTime?                  @map("revoked_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedByAccount Account      @relation("MembershipInvitationInviter", fields: [invitedByAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("membership_invitations")
}

model Role {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  key            String
  name           String
  scope          RoleScope @default(tenant)
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rolePermissions RolePermission[]

  @@unique([organizationId, key, scope])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  category    String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?     @map("organization_id")
  action         AuditAction
  resource       String?
  resourceId     String?     @map("resource_id")
  metadata       Json?
  requestId      String?     @map("request_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, action])
  @@map("audit_logs")
}
